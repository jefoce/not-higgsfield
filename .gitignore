# env files (can opt-in for committing if needed)
.env*
!.env.example

# local storage
.cache/

# tauri
src-tauri/binaries/
src-tauri/resources/
/src-tauri/target

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
