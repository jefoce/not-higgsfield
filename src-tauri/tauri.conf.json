{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Not Higgsfield",
  "mainBinaryName": "not-higgsfield",
  "version": "../package.json",
  "identifier": "com.jefoce.not-higgsfield",
  "build": {
    "frontendDist": "./splash",
    "devUrl": "http://127.0.0.1:3000",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm desktop:prepare"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "untrusted comment: minisign public key: 89CF3DDB4BA85203\nRWQDUqhL2z3PiUvLnFUu5vQcJYRaqMqz8a2wgLbBRISzgzLmkeX/sRvK",
      "endpoints": [
        "https://github.com/jefoce/not-higgsfield/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "nsis", "appimage", "deb", "rpm"],
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/not-higgsfield-server", "binaries/ffmpeg"],
    "resources": {
      "resources/server/": "server/",
      "resources/THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "resources/LICENSE": "LICENSE",
      "resources/licenses/": "licenses/"
    },
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist"
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    },
    "linux": {
      "deb": {
        "depends": ["gstreamer1.0-plugins-good", "gstreamer1.0-plugins-bad", "gstreamer1.0-libav"]
      },
      "rpm": { "depends": ["gstreamer1-plugins-good", "gstreamer1-plugins-bad-free"] },
      "appimage": { "bundleMediaFramework": true }
    }
  }
}
