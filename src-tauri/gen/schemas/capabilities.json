{
  "main": {
    "identifier": "main",
    "description": "Permissions for the Not Higgsfield webview",
    "remote": { "urls": ["http://127.0.0.1:*/*"] },
    "local": true,
    "windows": ["main"],
    "permissions": [
      "core:default",
      "dialog:allow-open",
      "dialog:allow-save",
      "dialog:allow-ask",
      "notification:default",
      { "identifier": "opener:allow-open-url", "allow": [{ "url": "https://openrouter.ai/*" }] }
    ]
  }
}
